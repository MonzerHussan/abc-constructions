# ============================================
# ABC Constructions Platform - Environment Template
# Copy to .env.local / .env.staging / .env.production and fill real values.
# NEVER commit .env* files. NEVER reuse a secret across environments.
# ============================================

# ------------------------------------------------------------------
# DATABASE - one dedicated URL per environment, never shared
#   Use a DEDICATED app role (NOT the postgres superuser) in every environment:
#   Dev:     postgresql://abc_app:DEV_PASSWORD@localhost:5432/abc_dev
#   Staging: postgresql://abc_app:STAGING_PASSWORD@staging-host:5432/abc_staging
#   Prod:    postgresql://abc_app:PROD_PASSWORD@prod-host:5432/abc_prod
# Rotate the password at least once before going live (see docs/security/security-audit.md).
# ------------------------------------------------------------------
DATABASE_URL="postgresql://abc_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/abc_constructions"

# Supabase (recommended split):
#   DATABASE_URL  = Session pooler (pooler.supabase.com:5432) for app runtime
#   DIRECT_URL    = Direct host (db.<ref>.supabase.co:5432) for prisma migrate only
# DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# Fail fast instead of hanging 30–120s when DB is unreachable (dev)
DATABASE_CONNECT_TIMEOUT_MS=15000
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------------
# AUTH (NextAuth v5) - REQUIRED, unique per environment
# Generate with: openssl rand -base64 32   (min 32 chars)
# ------------------------------------------------------------------
AUTH_SECRET="generate-a-random-secret-at-least-32-chars"

# Public base URL. Per environment:
#   Dev:     http://localhost:3002
#   Staging: https://staging.abc-construction.com
#   Prod:    https://abc-constructions-gray.vercel.app
NEXTAUTH_URL="http://localhost:3002"
AUTH_URL="http://localhost:3002"
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------
# GOOGLE OAUTH - optional; use SEPARATE client credentials per env
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
# 2. Authorized redirect URIs (add every environment you use):
#      http://localhost:3002/api/auth/callback/google
#      https://abc-constructions-gray.vercel.app/api/auth/callback/google
# 3. Client ID must end with: .apps.googleusercontent.com
# 4. On Vercel: set AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, AUTH_URL (or NEXTAUTH_URL)
#    Run: powershell -File scripts/setup-vercel-google-auth.ps1
# 5. Restart `npm run dev` after updating .env
# ------------------------------------------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ------------------------------------------------------------------
# EMAIL PROVIDER - REQUIRED for password reset delivery
#   Use Resend (RESEND_API_KEY) OR an SMTP URL (EMAIL_SMTP_URL).
#   SMTP works with any provider: SendGrid, Mailgun, Amazon SES, etc.
#   EMAIL_FROM: the "from" address shown to recipients. For Resend you must
#   verify your sending domain first (e.g. noreply@abc-construction.com).
# ------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_SMTP_URL=""
EMAIL_FROM="ABC Constructions <noreply@abc-construction.com>"

# ------------------------------------------------------------------
# SMS (Twilio) - optional; used for phone verification OTP during onboarding
# In development, codes are logged to the server console when Twilio is not set.
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
CONTACT_VERIFICATION_SMS_DEV="true"

# ------------------------------------------------------------------
# OBSERVABILITY / FEATURES - not secrets, but keep them environment-aware
# ------------------------------------------------------------------
LOG_LEVEL="info"
APP_VERSION="0.1.0"

# ------------------------------------------------------------------
# ENVIRONMENT SEPARATION NOTES
# ------------------------------------------------------------------
# 1. Create one secret set per environment (dev / staging / prod).
# 2. Store production secrets ONLY in the host's secret manager
#    (Vercel Project Env, Neon/Supabase dashboard, or CI/CD secrets).
# 3. Local development: .env.local (gitignored).
# 4. CI: secrets injected via GitHub Actions "Secrets" (never in the workflow file).
# 5. If a secret was ever committed to git history, it MUST be rotated
#    even if the history is later rewritten (see docs/technical-debt.md).

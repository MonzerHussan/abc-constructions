enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  CLOSED
}

enum InventoryTransactionType {
  RECEIVED
  SHIPPED
  ADJUSTED
  RESERVED
  UNRESERVED
  RETURNED
  TRANSFERRED_IN
  TRANSFERRED_OUT
  DAMAGED
  EXPIRED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

model Warehouse {
  id              String          @id @default(cuid())
  supplierId      String
  name            String
  nameAr          String?
  address         String
  cityId          String?
  countryId       String?
  lat             Float?
  lng             Float?
  phone           String?

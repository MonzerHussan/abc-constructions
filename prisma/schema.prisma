generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  CONSULTANT
  CONTRACTOR
  SUBCONTRACTOR
  WORKSHOP
  FREELANCER
  SUPPLIER
  TRADER
  INDIVIDUAL
  COMPANY
  ENTITY
  ADMIN
  SUPER_ADMIN
}

/// Fixed platform account types (9) — used for registration, onboarding, and subcategory scoping.
enum PlatformAccountType {
  OWNER
  CONSULTANT
  CONTRACTOR
  SUBCONTRACTOR
  SUPPLIER
  TRADER
  INDIVIDUAL
  COMPANY
  ENTITY
}

enum TenderStatus {
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  ARTICLE
}

enum DeliveryStatus {
  REQUESTED
  PENDING_DRIVER
  DRIVER_ASSIGNED
  PICKING_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum VehicleType {
  MOTORCYCLE
  PICKUP
  TRUCK_SMALL
  TRUCK_MEDIUM
  TRUCK_LARGE
  FLATBED
  CRANE_TRUCK
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  TRANSFER
}

enum DeliveryPriority {
  NORMAL
  URGENT
  SCHEDULED
}

// ============================
// Procurement Enums
// ============================

enum PRPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PRStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
}

enum RFQStatus {
  DRAFT
  SENT
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
}

enum EvalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AwardStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  DECLINED
  CANCELLED
}

enum POStatus {
  DRAFT
  ISSUED
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum GRStatus {
  PENDING
  PARTIAL
  COMPLETE
  INSPECTED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  MATCHED
  PARTIALLY_MATCHED
  APPROVED
  AUTHORIZED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ============================
// Organization & RBAC Enums
// ============================

enum OrganizationType {
  PROJECT_OWNER
  CONSULTANT
  MAIN_CONTRACTOR
  SUBCONTRACTOR
  WORKSHOP
  FREELANCER
  SUPPLIER
  PLATFORM_ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  PARTIALLY_VERIFIED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum VerificationDocType {
  NATIONAL_ID
  PASSPORT
  SELFIE
  ADDRESS_PROOF
  COMMERCIAL_REGISTER
  TAX_CERTIFICATE
  COMPANY_LICENSE
  BANK_ACCOUNT
  PROFESSIONAL_CERT
  ENGINEERING_LICENSE
  CONTRACTOR_CLASSIFICATION
  AUTHORIZATION_LETTER
  VEHICLE_LICENSE
  OPERATING_PERMIT
  PORTFOLIO
  OTHER
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  VERIFY
  SUSPEND
  ACTIVATE
  DEACTIVATE
  ASSIGN_ROLE
  REVOKE_ROLE
  SUBMIT_BID
  AWARD_TENDER
  MAKE_PAYMENT
  APPROVE_PAYMENT
  UPLOAD_DOCUMENT
  CREATE_CAMPAIGN
  PUBLISH_CAMPAIGN
  SEND_INVITATION
  EXPORT_DATA
  GENERATE_INSIGHT
}

model Organization {
  id                 String           @id @default(cuid())
  name               String
  nameAr             String?
  type               OrganizationType
  logo               String?
  website            String?
  location           String?
  about              String?
  taxNumber          String?
  commercialRegister String?
  isVerified         Boolean          @default(false)
  verificationLevel  Int              @default(0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  users            UserOrganization[]
  roles            Role[]
  verifications    Verification[]
  auditLogs        AuditLog[]
  tendersCreated   ProjectTender[]    @relation("TenderOrg")
  materialTenders  MaterialTender[]   @relation("MaterialTenderOrg")
  projects         Project[]          @relation("ProjectOrg")
  jobs             Job[]              @relation("JobOrg")
  purchaseRequests PurchaseRequest[]  @relation("PROrganization")
  rfqs             RFQ[]              @relation("RFQOrganization")
  rfqSuppliers     RFQSupplier[]      @relation("RFQSupplierOrganization")
  quotations       Quotation[]        @relation("QuotationOrganization")
  purchaseOrders   PurchaseOrder[]    @relation("POOrganization")
  crmLeads         Lead[]
  crmContacts      CrmContact[]
  crmOpportunities Opportunity[]
  crmActivities    CrmActivity[]
  crmTasks         CrmTask[]
  crmMeetings      CrmMeeting[]
  crmNotes         CrmNote[]
  supplierProfile     SupplierProfile?
  supplierRatings     SupplierRating[]        @relation("OrgSupplierRating")
  buyerOrgRelationships SupplierRelationship[]  @relation("OrgBuyerRelationship")
  manufacturedProducts  ProductMaster[]          @relation("ManufacturerProducts")
  productReviews        ProductReview[]          @relation("OrgProductReviews")
  supplierReviews       SupplierReview[]         @relation("OrgSupplierReviews")
  favoriteProducts      FavoriteProduct[]        @relation("OrgFavoriteProducts")
  favoriteSuppliers     FavoriteSupplier[]       @relation("OrgFavoriteSuppliers")
}

model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  roleId         String?
  title          String?
  isPrimary      Boolean  @default(false)
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role?        @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
}

model Role {
  id               String           @id @default(cuid())
  name             String
  nameAr           String?
  description      String?
  organizationType OrganizationType
  isSystem         Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  permissions RolePermission[]
  users       UserOrganization[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  nameAr      String?
  module      String
  description String?

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Verification {
  id             String             @id @default(cuid())
  userId         String
  organizationId String?
  type           OrganizationType?
  level          Int                @default(0)
  status         VerificationStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     DateTime?
  notes          String?
  submittedAt    DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user         User                   @relation(fields: [userId], references: [id])
  organization Organization?          @relation(fields: [organizationId], references: [id])
  documents    VerificationDocument[]
}

model VerificationDocument {
  id             String              @id @default(cuid())
  verificationId String
  docType        VerificationDocType
  fileName       String
  fileUrl        String
  status         VerificationStatus  @default(PENDING)
  notes          String?
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())

  verification Verification @relation(fields: [verificationId], references: [id])
}

model AuditLog {
  id             String      @id @default(cuid())
  action         AuditAction
  entity         String
  entityId       String?
  details        Json?
  ip             String?
  userAgent      String?
  userId         String?
  organizationId String?
  createdAt      DateTime    @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String?
  name           String
  phone          String?
  avatar         String?
  role           UserRole  @default(OWNER)
  roleConfirmed  Boolean   @default(false)
  bio            String?
  companyName    String?
  companyLogo    String?
  website        String?
  location       String?
  isVerified     Boolean   @default(false)
  isActive       Boolean   @default(true)
  emailVerified  DateTime?
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  mfaBackupCodes String?
  mfaToken       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  projectTenders     ProjectTender[]
  materialTenders    MaterialTender[]
  projectTenderBids  ProjectTenderBid[]
  materialTenderBids MaterialTenderBid[]
  products           Product[]
  projects           Project[]
  jobs               Job[]
  jobApplications    JobApplication[]    @relation("Applicant")
  posts              Post[]
  postComments       PostComment[]
  postLikes          PostLike[]
  messages           Message[]           @relation("SentMessages")
  receivedMessages   Message[]           @relation("ReceivedMessages")
  notifications      Notification[]
  savedProducts      SavedProduct[]
  savedProjects      SavedProject[]
  savedJobs          SavedJob[]
  reviewsGiven       Review[]            @relation("ReviewAuthor")
  reviewsReceived    Review[]            @relation("ReviewTarget")

  driverProfile          DriverProfile?
  deliveryOrdersSent     DeliveryOrder[]  @relation("DeliverySender")
  deliveryOrdersReceived DeliveryOrder[]  @relation("DeliveryReceiver")
  deliveryReviews        DeliveryReview[] @relation("DeliveryReviewAuthor")

  organizations UserOrganization[]
  verifications Verification[]
  auditLogs     AuditLog[]
  courses       Course[]
  enrollments   CourseEnrollment[]
  certificates  Certificate[]

  purchaseRequestsRequested PurchaseRequest[] @relation("PRRequestedBy")
  purchaseRequestsApproved  PurchaseRequest[] @relation("PRApprovedBy")
  rfqsCreated               RFQ[]             @relation("RFQCreatedBy")
  rfqSupplierInvitations    RFQSupplier[]     @relation("RFQSupplierSupplier")
  quotationsSupplier        Quotation[]       @relation("QuotationSupplier")
  evaluationsAssigned       Evaluation[]        @relation("EvaluationEvaluator")
  quotationEvaluationsAssigned QuotationEvaluation[] @relation("QuotationEvaluator")
  approvalRequestsRequested   ApprovalRequest[]     @relation("ApprovalRequester")
  approvalActions             ApprovalHistory[]     @relation("ApprovalActor")
  awardsReceived            Award[]           @relation("AwardSupplier")
  awardsAwarded             Award[]           @relation("AwardAwarder")
  purchaseOrdersSupplier    PurchaseOrder[]   @relation("POSupplier")
  purchaseOrdersCreated     PurchaseOrder[]   @relation("POCreatedBy")
  goodsReceiptsSupplier     GoodsReceipt[]    @relation("GRSupplier")
  goodsReceiptsReceived     GoodsReceipt[]    @relation("GRReceiver")
  deliveriesSupplier        Delivery[]        @relation("DeliverySupplier")
  deliveriesCreated         Delivery[]        @relation("DeliveryCreator")
  invoicesSupplier          Invoice[]         @relation("InvoiceSupplier")
  invoicesBuyer             Invoice[]         @relation("InvoiceBuyer")
  paymentsMade              Payment[]         @relation("PaymentPayer")
  ratingsGiven              SupplierRating[]  @relation("RatingRater")
  ratingsReceived           SupplierRating[]  @relation("RatingSupplier")
  supplierProfile           SupplierProfile?
  verifiedSupplierDocs      SupplierDocument[] @relation("DocumentVerifiedBy")
  inventoryTransactions     InventoryTransaction[]
  inventoryImports          InventoryImport[]

  researchCampaigns       ResearchCampaign[]
  researchParticipants    ResearchParticipant[]
  surveyResponses         SurveyResponse[]
  featureRequests         FeatureRequest[]
  featureVotes            FeatureVote[]
  feedback                Feedback[]
  bugReports              BugReport[]
  npsScores               NpsScore[]
  csatScores              CsatScore[]
  passwordResetTokens     PasswordResetToken[]
  cesScores               CesScore[]
  journeyEvents           CustomerJourneyEvent[]
  crmLinkedContacts       CrmContact[]
  crmLeads                Lead[]                 @relation("LeadAssignee")
  crmLeadsCreated         Lead[]                 @relation("LeadCreator")
  crmOwnedContacts        CrmContact[]           @relation("ContactOwner")
  crmOwnedOpportunities   Opportunity[]          @relation("OpportunityOwner")
  crmCreatedOpportunities Opportunity[]          @relation("OpportunityCreator")
  crmAssignedActivities   CrmActivity[]          @relation("ActivityAssignee")
  crmCreatedActivities    CrmActivity[]          @relation("ActivityCreator")
  crmAssignedTasks        CrmTask[]              @relation("TaskAssignee")
  crmCreatedTasks         CrmTask[]              @relation("TaskCreator")
  crmOrganizedMeetings    CrmMeeting[]           @relation("MeetingOrganizer")
  crmCreatedNotes         CrmNote[]              @relation("NoteCreator")

  qualityInspections      Inspection[]           @relation("QualityInspector")
  qualityNCRs             NCR[]                  @relation("NCRCreator")
  qualityCertificates     AcceptanceCertificate[] @relation("CertificateAcceptor")
  qualityAttachments      InspectionAttachment[] @relation("AttachmentUploader")

  paymentReservationsSupplier PaymentReservation[] @relation("PaymentSupplier")
  paymentReservationsBuyer    PaymentReservation[] @relation("PaymentBuyer")
  paymentReleases             PaymentRelease[]     @relation("PaymentReleaseActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProjectTender {
  id             String       @id @default(cuid())
  title          String
  description    String
  category       String
  location       String
  budgetMin      Float?
  budgetMax      Float?
  deadline       DateTime
  requirements   String?
  attachments    String[]
  status         TenderStatus @default(OPEN)
  userId         String
  organizationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  organization Organization?      @relation("TenderOrg", fields: [organizationId], references: [id])
  bids         ProjectTenderBid[]
}

model ProjectTenderBid {
  id              String    @id @default(cuid())
  amount          Float
  proposal        String
  duration        String?
  status          BidStatus @default(PENDING)
  projectTenderId String
  userId          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projectTender ProjectTender @relation(fields: [projectTenderId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
}

model MaterialTender {
  id             String       @id @default(cuid())
  title          String
  description    String
  materialType   String
  categoryId     String?
  subcategoryId  String?
  brandId        String?
  quantity       String
  unit           String
  specifications String?
  deliveryDate   DateTime?
  location       String
  budgetMax      Float?
  status         TenderStatus @default(OPEN)
  userId         String
  organizationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user              User                     @relation(fields: [userId], references: [id])
  organization      Organization?            @relation("MaterialTenderOrg", fields: [organizationId], references: [id])
  category          MaterialCategory?        @relation(fields: [categoryId], references: [id])
  subcategory       MaterialSubcategory?     @relation(fields: [subcategoryId], references: [id])
  brand             Brand?                   @relation(fields: [brandId], references: [id])
  bids              MaterialTenderBid[]
  tags              MaterialTenderTag[]
  supplierInterests SupplierTenderInterest[]
}

model MaterialTenderBid {
  id               String    @id @default(cuid())
  unitPrice        Float
  totalPrice       Float
  proposal         String
  deliveryTime     String?
  status           BidStatus @default(PENDING)
  materialTenderId String
  userId           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  materialTender MaterialTender @relation(fields: [materialTenderId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String
  category       String
  price          Float
  unit           String
  minQuantity    Int?
  images         String[]
  specifications String?
  inStock        Boolean  @default(true)
  location       String
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                  User                 @relation(fields: [userId], references: [id])
  savedBy               SavedProduct[]
  materialSubcategory   MaterialSubcategory? @relation(fields: [materialSubcategoryId], references: [id])
  materialSubcategoryId String?
  brand                 Brand?               @relation(fields: [brandId], references: [id])
  brandId               String?
  productTags           ProductTag[]
}

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Project {
  id             String        @id @default(cuid())
  title          String
  description    String
  category       String
  location       String
  clientName     String?
  budget         Float?
  area           String?
  startDate      DateTime?
  endDate        DateTime?
  images         String[]
  status         ProjectStatus @default(PLANNING)
  highlights     String?
  userId         String
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User           @relation(fields: [userId], references: [id])
  organization Organization?  @relation("ProjectOrg", fields: [organizationId], references: [id])
  savedBy      SavedProject[]

  purchaseRequests PurchaseRequest[] @relation("PRProject")
  rfqs             RFQ[]             @relation("RFQProject")
  purchaseOrders   PurchaseOrder[]   @relation("POProject")
}

model SavedProject {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
}

model Job {
  id             String   @id @default(cuid())
  title          String
  description    String
  category       String
  jobType        JobType
  salary         String?
  salaryMin      Float?
  salaryMax      Float?
  location       String
  requirements   String?
  benefits       String?
  vacancies      Int      @default(1)
  isUrgent       Boolean  @default(false)
  isActive       Boolean  @default(true)
  userId         String
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  organization Organization?    @relation("JobOrg", fields: [organizationId], references: [id])
  applications JobApplication[] @relation("JobApplications")
  savedBy      SavedJob[]
}

model JobApplication {
  id          String   @id @default(cuid())
  coverLetter String?
  cv          String?
  status      String   @default("pending")
  jobId       String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job  Job  @relation("JobApplications", fields: [jobId], references: [id])
  user User @relation("Applicant", fields: [userId], references: [id])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
}

model Post {
  id            String   @id @default(cuid())
  content       String
  type          PostType @default(TEXT)
  images        String[]
  tags          String[]
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  comments PostComment[]
  likes    PostLike[]
}

model PostComment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  authorId  String
  targetId  String
  createdAt DateTime @default(now())

  author User @relation("ReviewAuthor", fields: [authorId], references: [id])
  target User @relation("ReviewTarget", fields: [targetId], references: [id])
}

// ============================
// Academy / Training Models
// ============================

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  PDF
  QUIZ
  ASSIGNMENT
}

model Course {
  id              String       @id @default(cuid())
  title           String
  titleEn         String?
  titleUr         String?
  description     String
  descriptionEn   String?
  descriptionUr   String?
  category        String
  level           CourseLevel  @default(BEGINNER)
  price           Float        @default(0)
  originalPrice   Float?
  thumbnail       String?
  duration        String?
  lessonsCount    Int          @default(0)
  studentsCount   Int          @default(0)
  rating          Float        @default(0)
  reviewsCount    Int          @default(0)
  instructorId    String
  instructorName  String
  instructorTitle String?
  tags            String[]
  isPublished     Boolean      @default(false)
  isBestseller    Boolean      @default(false)
  status          CourseStatus @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  instructor   User               @relation(fields: [instructorId], references: [id])
  lessons      CourseLesson[]
  enrollments  CourseEnrollment[]
  certificates Certificate[]
}

model CourseLesson {
  id          String     @id @default(cuid())
  title       String
  titleEn     String?
  description String?
  lessonType  LessonType @default(VIDEO)
  videoUrl    String?
  pdfUrl      String?
  duration    String?
  orderIndex  Int        @default(0)
  isFree      Boolean    @default(false)
  courseId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  course Course @relation(fields: [courseId], references: [id])

  @@index([courseId, orderIndex])
}

model CourseEnrollment {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  progress         Float     @default(0)
  completedLessons Int       @default(0)
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  enrolledAt       DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  certificate Certificate?

  @@unique([userId, courseId])
}

model Certificate {
  id             String    @id @default(cuid())
  title          String
  userId         String
  courseId       String
  enrollmentId   String    @unique
  certificateUrl String?
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime?

  user       User             @relation(fields: [userId], references: [id])
  course     Course           @relation(fields: [courseId], references: [id])
  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id])
}

// ============================
// Procurement Core Models
// ============================

model PurchaseRequest {
  id               String     @id @default(cuid())
  title            String
  description      String?
  category         String
  priority         PRPriority @default(MEDIUM)
  status           PRStatus   @default(DRAFT)
  requestedById    String
  approvedById     String?
  projectId        String?
  organizationId   String?
  expectedDelivery DateTime?
  deliveryLocation String?
  attachments      String[]
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  requestedBy  User          @relation("PRRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?         @relation("PRApprovedBy", fields: [approvedById], references: [id])
  project      Project?      @relation("PRProject", fields: [projectId], references: [id])
  organization Organization? @relation("PROrganization", fields: [organizationId], references: [id])

  rfqs  RFQ[]
  items PurchaseRequestItem[]

  @@index([status])
  @@index([requestedById])
  @@index([organizationId])
  @@index([createdAt])
}

model PurchaseRequestItem {
  id                String  @id @default(cuid())
  purchaseRequestId String
  materialName      String
  description       String?
  quantity          Float
  unit              String
  estimatedPrice    Float?
  total             Float?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])

  @@index([purchaseRequestId])
}

model RFQ {
  id                 String    @id @default(cuid())
  title              String
  description        String?
  referenceNumber    String    @unique
  status             RFQStatus @default(DRAFT)
  purchaseRequestId  String?
  projectId          String?
  organizationId     String?
  issueDate          DateTime?
  deadlineDate       DateTime
  deliveryDate       DateTime?
  deliveryLocation   String?
  termsAndConditions String?
  attachments        String[]
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  project         Project?         @relation("RFQProject", fields: [projectId], references: [id])
  organization    Organization?    @relation("RFQOrganization", fields: [organizationId], references: [id])
  createdBy       User             @relation("RFQCreatedBy", fields: [createdById], references: [id])

  items               RFQItem[]
  suppliers           RFQSupplier[]
  quotations          Quotation[]
  evaluations         Evaluation[]
  evaluationCriteria  EvaluationCriterion[]
  awards              Award[]
  purchaseOrders      PurchaseOrder[]

  @@index([status])
  @@index([referenceNumber])
  @@index([createdById])
  @@index([organizationId])
  @@index([createdAt])
}

model RFQItem {
  id             String  @id @default(cuid())
  rfqId          String
  materialName   String
  description    String?
  quantity       Float
  unit           String
  specifications String?

  rfq RFQ @relation(fields: [rfqId], references: [id])

  quotationItems QuotationItem[]

  @@index([rfqId])
}

model RFQSupplier {
  id             String    @id @default(cuid())
  rfqId          String
  supplierId     String
  organizationId String?
  invitedAt      DateTime  @default(now())
  respondedAt    DateTime?
  responded      Boolean   @default(false)

  rfq          RFQ           @relation(fields: [rfqId], references: [id])
  supplier     User          @relation("RFQSupplierSupplier", fields: [supplierId], references: [id])
  organization Organization? @relation("RFQSupplierOrganization", fields: [organizationId], references: [id])

  @@index([rfqId])
  @@index([supplierId])
  @@index([responded])
}

model Quotation {
  id              String          @id @default(cuid())
  rfqId           String
  supplierId      String
  organizationId  String?
  referenceNumber String          @unique
  status          QuotationStatus @default(DRAFT)
  coverLetter     String?
  deliveryTime    String?
  validUntil      DateTime?
  totalAmount     Float
  taxAmount       Float           @default(0)
  grandTotal      Float
  currency        String          @default("SAR")
  notes           String?
  submittedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  rfq          RFQ           @relation(fields: [rfqId], references: [id])
  supplier     User          @relation("QuotationSupplier", fields: [supplierId], references: [id])
  organization Organization? @relation("QuotationOrganization", fields: [organizationId], references: [id])

  items               QuotationItem[]
  awards              Award[]
  purchaseOrders      PurchaseOrder[]
  quotationEvaluations QuotationEvaluation[]

  @@index([rfqId])
  @@index([supplierId])
  @@index([status])
  @@index([referenceNumber])
}

model QuotationItem {
  id           String  @id @default(cuid())
  quotationId  String
  rfqItemId    String?
  materialName String
  description  String?
  quantity     Float
  unit         String
  unitPrice    Float
  totalPrice   Float

  quotation Quotation @relation(fields: [quotationId], references: [id])
  rfqItem   RFQItem?  @relation(fields: [rfqItemId], references: [id])

  @@index([quotationId])
}

model EvaluationCriterion {
  id          String  @id @default(cuid())
  rfqId       String?
  name        String
  description String?
  maxScore    Float
  weight      Float   @default(1.0)
  orderIndex  Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rfq    RFQ?              @relation(fields: [rfqId], references: [id])
  scores EvaluationScore[]

  @@index([rfqId])
}

model EvaluationScore {
  id                   String              @id @default(cuid())
  quotationEvaluationId String
  criterionId          String
  score                Float
  comment              String?
  createdAt            DateTime            @default(now())

  quotationEvaluation QuotationEvaluation @relation(fields: [quotationEvaluationId], references: [id])
  criterion           EvaluationCriterion @relation(fields: [criterionId], references: [id])

  @@index([quotationEvaluationId])
  @@index([criterionId])
}

model QuotationEvaluation {
  id           String     @id @default(cuid())
  quotationId  String
  evaluatorId  String
  status       EvalStatus @default(PENDING)
  totalScore   Float?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  quotation       Quotation         @relation(fields: [quotationId], references: [id])
  evaluator       User              @relation("QuotationEvaluator", fields: [evaluatorId], references: [id])
  scores          EvaluationScore[]
  approvalRequest ApprovalRequest?

  @@index([quotationId])
  @@index([evaluatorId])
  @@index([status])
}

model ApprovalRequest {
  id                     String         @id @default(cuid())
  quotationEvaluationId  String         @unique
  requestedById          String
  status                 ApprovalStatus @default(PENDING)
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  quotationEvaluation QuotationEvaluation @relation(fields: [quotationEvaluationId], references: [id])
  requestedBy         User                @relation("ApprovalRequester", fields: [requestedById], references: [id])
  history             ApprovalHistory[]
}

model ApprovalHistory {
  id                String         @id @default(cuid())
  approvalRequestId String
  action            ApprovalStatus
  comment           String?
  actionById        String
  createdAt         DateTime       @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  actionBy        User            @relation("ApprovalActor", fields: [actionById], references: [id])

  @@index([approvalRequestId])
}

model Evaluation {
  id          String     @id @default(cuid())
  rfqId       String
  evaluatorId String
  status      EvalStatus @default(PENDING)
  criteria    Json?
  totalScore  Float?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  rfq       RFQ  @relation(fields: [rfqId], references: [id])
  evaluator User @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id])

  @@index([rfqId])
  @@index([evaluatorId])
  @@index([status])
}

model Award {
  id          String      @id @default(cuid())
  rfqId       String
  quotationId String
  supplierId  String
  awardedById String
  awardDate   DateTime    @default(now())
  totalAmount Float
  notes       String?
  status      AwardStatus @default(PENDING_ACCEPTANCE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  rfq       RFQ       @relation(fields: [rfqId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])
  supplier  User      @relation("AwardSupplier", fields: [supplierId], references: [id])
  awardedBy User      @relation("AwardAwarder", fields: [awardedById], references: [id])

  purchaseOrders PurchaseOrder[]

  @@index([rfqId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrder {
  id                   String    @id @default(cuid())
  poNumber             String    @unique
  rfqId                String?
  quotationId          String?
  awardId              String?
  projectId            String?
  supplierId           String
  organizationId       String?
  status               POStatus  @default(DRAFT)
  orderDate            DateTime  @default(now())
  expectedDelivery     DateTime?
  deliveryDate         DateTime?
  subtotal             Float
  taxAmount            Float     @default(0)
  totalAmount          Float
  deliveryAddress      String?
  deliveryInstructions String?
  paymentTerms         String?
  notes                String?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  rfq          RFQ?          @relation(fields: [rfqId], references: [id])
  quotation    Quotation?    @relation(fields: [quotationId], references: [id])
  award        Award?        @relation(fields: [awardId], references: [id])
  project      Project?      @relation("POProject", fields: [projectId], references: [id])
  supplier     User          @relation("POSupplier", fields: [supplierId], references: [id])
  organization Organization? @relation("POOrganization", fields: [organizationId], references: [id])
  createdBy    User          @relation("POCreatedBy", fields: [createdById], references: [id])

  items           POItem[]
  goodsReceipts   GoodsReceipt[]
  deliveries      Delivery[]
  paymentReservations PaymentReservation[]
  invoices        Invoice[]
  payments        Payment[]
  supplierRatings SupplierRating[]

  @@index([status])
  @@index([supplierId])
  @@index([organizationId])
  @@index([createdById])
  @@index([createdAt])
}

model POItem {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  materialName      String
  description       String?
  quantity          Float
  unit              String
  unitPrice         Float
  totalPrice        Float
  deliveredQuantity Float    @default(0)
  balanceQuantity   Float
  batchNumber       String?
  lotNumber         String?
  serialNumber      String?
  manufacturer      String?
  countryOfOrigin   String?
  productionDate    DateTime?
  expiryDate        DateTime?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  goodsReceipts      GoodsReceipt[]
  deliveryItems      DeliveryItem[]
  invoiceItems       InvoiceItem[]
  inspectionItems    InspectionItem[]

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  receiptNumber   String   @unique
  purchaseOrderId String
  deliveryId      String?
  poItemId        String?
  supplierId      String
  status          GRStatus @default(PENDING)
  receivedDate    DateTime @default(now())
  receivedById    String
  notes           String?
  attachments     String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  delivery      Delivery?     @relation(fields: [deliveryId], references: [id])
  poItem        POItem?       @relation(fields: [poItemId], references: [id])
  supplier      User          @relation("GRSupplier", fields: [supplierId], references: [id])
  receivedBy    User          @relation("GRReceiver", fields: [receivedById], references: [id])

  @@index([purchaseOrderId])
  @@index([deliveryId])
  @@index([supplierId])
  @@index([status])
  @@index([receiptNumber])
}

enum PODeliveryStatus {
  SCHEDULED
  DISPATCHED
  IN_TRANSIT
  ARRIVED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  PARTIAL
  NCR_CREATED
  ACCEPTED
}

enum InspectionItemResult {
  PASS
  FAIL
  N_A
}

enum NCRSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NCRStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PaymentReservationStatus {
  RESERVED
  HELD
  PARTIALLY_RELEASED
  RELEASED
  REFUNDED
  CANCELLED
}

enum PaymentReleaseType {
  PARTIAL
  FULL
  REFUND
}

model Delivery {
  id             String           @id @default(cuid())
  deliveryNumber String           @unique
  purchaseOrderId String
  supplierId     String
  driverName     String?
  driverPhone    String?
  vehicleNumber  String?
  status         PODeliveryStatus @default(SCHEDULED)
  scheduledDate  DateTime?
  dispatchedAt   DateTime?
  arrivedAt      DateTime?
  notes          String?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier      User          @relation("DeliverySupplier", fields: [supplierId], references: [id])
  createdBy     User          @relation("DeliveryCreator", fields: [createdById], references: [id])
  items         DeliveryItem[]
  goodsReceipts GoodsReceipt[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status])
}

model DeliveryItem {
  id         String @id @default(cuid())
  deliveryId String
  poItemId   String
  quantity   Float
  notes      String?
  createdAt  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  poItem   POItem   @relation(fields: [poItemId], references: [id])

  inspections InspectionItem[]

  @@index([deliveryId])
  @@index([poItemId])
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  purchaseOrderId String
  supplierId      String
  buyerId         String?
  status          InvoiceStatus @default(DRAFT)
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  amount          Float
  taxAmount       Float         @default(0)
  totalAmount     Float
  paidAmount      Float         @default(0)
  balanceAmount   Float
  attachment      String?
  notes           String?
  submittedAt     DateTime?
  verifiedAt      DateTime?
  matchedAt       DateTime?
  authorizedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplier      User          @relation("InvoiceSupplier", fields: [supplierId], references: [id])
  buyer         User?         @relation("InvoiceBuyer", fields: [buyerId], references: [id])

  items    InvoiceItem[]
  payments Payment[]
  matches  InvoiceMatch[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([status])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  poItemId    String?
  deliveryItemId String?
  description String?
  quantity    Float
  unitPrice   Float
  totalPrice  Float
  taxRate     Float   @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  poItem  POItem? @relation(fields: [poItemId], references: [id])

  @@index([invoiceId])
  @@index([poItemId])
}

enum MatchStatus {
  MATCHED
  MISMATCH
  PENDING
}

model InvoiceMatch {
  id               String      @id @default(cuid())
  invoiceId        String
  referenceType    String      // PO, DELIVERY, INSPECTION
  referenceId      String
  status           MatchStatus @default(PENDING)
  poQuantity       Float?
  deliveryQuantity Float?
  acceptedQuantity Float?
  invoiceQuantity  Float?
  poAmount         Float?
  deliveryAmount   Float?
  invoiceAmount    Float?
  varianceQuantity Float?
  varianceAmount   Float?
  notes            String?
  matchedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([referenceType, referenceId])
  @@unique([invoiceId, referenceType, referenceId])
}

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique
  invoiceId       String
  purchaseOrderId String?
  paidById        String
  amount          Float
  method          PaymentMethod @default(CASH)
  status          PaymentStatus @default(PENDING)
  transactionId   String?
  referenceNumber String?
  notes           String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoice       Invoice        @relation(fields: [invoiceId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  paidBy        User           @relation("PaymentPayer", fields: [paidById], references: [id])

  @@index([invoiceId])
  @@index([paidById])
  @@index([status])
  @@index([paymentNumber])
}

model SupplierRating {
  id                String   @id @default(cuid())
  supplierId        String
  supplierProfileId String?
  purchaseOrderId   String?
  organizationId    String?
  ratedById         String
  rating            Int
  quality           Int?
  delivery          Int?
  communication     Int?
  price             Int?
  comment           String?
  createdAt         DateTime @default(now())

  supplier        User             @relation("RatingSupplier", fields: [supplierId], references: [id])
  supplierProfile SupplierProfile? @relation(fields: [supplierProfileId], references: [id])
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  ratedBy         User             @relation("RatingRater", fields: [ratedById], references: [id])
  organization    Organization?    @relation("OrgSupplierRating", fields: [organizationId], references: [id])

  @@index([supplierId])
  @@index([supplierProfileId])
  @@index([ratedById])
  @@index([organizationId])
  @@index([purchaseOrderId])
}

// ============================
// Delivery System Models
// ============================

model DriverProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  vehicleType     VehicleType
  plateNumber     String
  vehicleBrand    String
  vehicleModel    String
  vehicleYear     Int?
  vehicleColor    String?
  licenseNumber   String
  licenseExpiry   DateTime
  isAvailable     Boolean     @default(true)
  isApproved      Boolean     @default(false)
  currentLat      Float?
  currentLng      Float?
  totalDeliveries Int         @default(0)
  totalEarnings   Float       @default(0)
  avgRating       Float       @default(5.0)
  totalRatings    Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  orders          DeliveryOrder[]  @relation("DeliveryDriver")
  deliveryReviews DeliveryReview[] @relation("DeliveryReviewDriver")
}

model DeliveryOrder {
  id            String           @id @default(cuid())
  orderNumber   String           @unique
  status        DeliveryStatus   @default(REQUESTED)
  priority      DeliveryPriority @default(NORMAL)
  paymentMethod PaymentMethod    @default(CASH)

  senderId   String
  receiverId String?
  driverId   String?

  pickupName    String
  pickupPhone   String
  pickupAddress String
  pickupLat     Float?
  pickupLng     Float?
  pickupNotes   String?

  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryLat     Float?
  deliveryLng     Float?
  deliveryNotes   String?

  materialType         String
  description          String
  weight               Float?
  dimensions           String?
  quantity             Int          @default(1)
  fragile              Boolean      @default(false)
  needsCrane           Boolean      @default(false)
  preferredVehicleType VehicleType?

  basePrice   Float
  distanceFee Float @default(0)
  weightFee   Float @default(0)
  urgentFee   Float @default(0)
  totalPrice  Float

  scheduledDate DateTime?
  scheduledTime String?
  pickupTime    DateTime?
  deliveryTime  DateTime?
  estimatedTime String?

  cancelReason String?
  notes        String?
  trackingCode String  @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender   User           @relation("DeliverySender", fields: [senderId], references: [id])
  receiver User?          @relation("DeliveryReceiver", fields: [receiverId], references: [id])
  driver   DriverProfile? @relation("DeliveryDriver", fields: [driverId], references: [id])

  reviews       DeliveryReview[]
  statusHistory DeliveryStatusHistory[]
}

model DeliveryStatusHistory {
  id        String         @id @default(cuid())
  orderId   String
  status    DeliveryStatus
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime       @default(now())

  order DeliveryOrder @relation(fields: [orderId], references: [id])
}

model DeliveryReview {
  id        String   @id @default(cuid())
  orderId   String
  authorId  String
  driverId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order  DeliveryOrder @relation(fields: [orderId], references: [id])
  author User          @relation("DeliveryReviewAuthor", fields: [authorId], references: [id])
  driver DriverProfile @relation("DeliveryReviewDriver", fields: [driverId], references: [id])
}

// ============================
// Supplier Classification & Marketplace Models
// ============================

enum SupplierType {
  MANUFACTURER
  AUTHORIZED_DISTRIBUTOR
  WHOLESALER
  RETAIL_SUPPLIER
  IMPORTER
  SERVICE_SUPPLIER
  DISTRIBUTOR
  DEALER
  SUPPLIER
  RENTAL_COMPANY
  MAINTENANCE_COMPANY
  TRADER
}

// ============================
// Material Categories (18 Main Categories)
// ============================

model MaterialCategory {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  description String?
  slug        String   @unique
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subcategories      MaterialSubcategory[]
  supplierCategories SupplierCategory[]
  tenders            MaterialTender[]
  tags               CategoryTag[]
  productMasterProducts ProductMaster[]
}

model MaterialSubcategory {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  description String?
  slug        String
  categoryId  String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category MaterialCategory @relation(fields: [categoryId], references: [id])
  products Product[]
  tenders  MaterialTender[]
  productMasterProducts ProductMaster[]

  @@unique([slug, categoryId])
  @@index([categoryId])
}

// ============================
// Brand Management
// ============================

model Brand {
  id              String   @id @default(cuid())
  name            String
  nameAr          String?
  description     String?
  logo            String?
  website         String?
  countryOfOrigin String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplierBrands  SupplierBrand[]
  products        Product[]
  materialTenders MaterialTender[]
  productMasterProducts ProductMaster[]
}

model SupplierBrand {
  id           String   @id @default(cuid())
  supplierId   String
  brandId      String
  isAuthorized Boolean  @default(false)
  createdAt    DateTime @default(now())

  supplier SupplierProfile @relation(fields: [supplierId], references: [id])
  brand    Brand           @relation(fields: [brandId], references: [id])

  @@unique([supplierId, brandId])
  @@index([supplierId])
  @@index([brandId])

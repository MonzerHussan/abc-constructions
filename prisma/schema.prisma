model SupplierProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  entityId           String?            // 🔗 Bridge to Entity Registry (plain string, no FK — Architecture Isolation preserved)
  organizationId     String?            @unique
  supplierType       SupplierType[]
  supplierTypeOther  String?
  companyName        String
  companyNameAr      String?
  companyNameUr      String?
  commercialLicense  String?
  licenseNumber      String?
  taxNumber          String?
  vatRegistered      Boolean            @default(false)
  yearEstablished    Int?
  employeeCount      Int?
  country            String?
  emirate            String?
  city               String?
  countryId          String?
  cityId             String?
  location           String?
  website            String?
  about              String?
  aboutAr            String?
  aboutUr            String?
  logo               String?
  coverImage         String?
  minOrderValue      Float?
  maxDailyCapacity   Float?
  monthlyCapacity    Float?
  leadTimeDays       Int?
  transportTypes     String[]
  countriesServed    String[]
  workingHours       String?
  hasWarehouses      Boolean            @default(false)
  hasBranches        Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verificationLevel  SupplierVerificationLevel @default(UNVERIFIED)
  performanceScore   Float              @default(0)
  totalOrders        Int                @default(0)
  completedOrders    Int                @default(0)
  onTimeDeliveryRate Float              @default(0)
  avgRating          Float              @default(0)
  totalRatings       Int                @default(0)
  avgResponseTime    Int?
  avgResponseTimeHours Int?
  winRate            Float              @default(0)
  totalSpend         Float              @default(0)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user                    User                           @relation(fields: [userId], references: [id])
  organization            Organization?                  @relation(fields: [organizationId], references: [id])
  branches                SupplierBranch[]
  categories              SupplierCategory[]
  brands                  SupplierBrand[]
  supplierTenderInterests SupplierTenderInterest[]
  documents               SupplierDocument[]
  certifications          SupplierCertification[]
  bankingInfo             SupplierBanking?
  coverageAreas           SupplierCoverageArea[]
  capabilities            SupplierCapability[]
  projectRefs             SupplierProjectReference[]
  relationships           SupplierRelationship[]         @relation("SupplierProfileRelationship")
  ratings                 SupplierRating[]
  productOfferings        SupplierProductOffering[]
  warehouses              Warehouse[]
  inventoryImports        InventoryImport[]
  reviews                 SupplierReview[]
  favoriteByOrganizations FavoriteSupplier[]

  @@index([supplierType])
  @@index([verificationStatus])
  @@index([verificationLevel])
  @@index([performanceScore])
  @@index([emirate])
  @@index([avgRating])
}

model SupplierBranch {
  id          String   @id @default(cuid())
  supplierId  String
  name        String
  nameAr      String?
  address     String
  city        String
  emirate     String?
  country     String
  cityId      String?
  countryId   String?
  phone       String?
  email       String?
  managerName String?
  lat         Float?
  lng         Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([cityId])
}

model SupplierCategory {
  id            String   @id @default(cuid())
  supplierId    String
  categoryId    String
  subcategoryId String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  supplier SupplierProfile  @relation(fields: [supplierId], references: [id])
  category MaterialCategory @relation(fields: [categoryId], references: [id])

  @@unique([supplierId, categoryId, subcategoryId])
  @@index([supplierId])
  @@index([categoryId])
}

// ============================
// Material Tender Enhancements (linking to categories)
// ============================

// We need to add category relation to existing MaterialTender
// Note: MaterialTender already exists, we add optional relations

// Add tags to MaterialTender through a join table
model MaterialTenderTag {
  id        String   @id @default(cuid())
  tenderId  String
  tagId     String
  createdAt DateTime @default(now())

  tender MaterialTender @relation(fields: [tenderId], references: [id])
  tag    Tag            @relation(fields: [tagId], references: [id])

  @@unique([tenderId, tagId])
  @@index([tenderId])
  @@index([tagId])
}

// Supplier Tender Interest (for recommendation engine)
model SupplierTenderInterest {
  id            String   @id @default(cuid())
  supplierId    String
  tenderId      String
  interestLevel Float    @default(0)
  isNotified    Boolean  @default(false)
  isViewed      Boolean  @default(false)
  isApplied     Boolean  @default(false)
  matchReason   String?
  createdAt     DateTime @default(now())

  supplier SupplierProfile @relation(fields: [supplierId], references: [id])
  tender   MaterialTender  @relation(fields: [tenderId], references: [id])

  @@unique([supplierId, tenderId])
  @@index([supplierId])
  @@index([tenderId])
}


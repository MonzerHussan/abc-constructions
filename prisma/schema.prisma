// ─── CRM Module ───────────────────────────────────────────────────────────
enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  COLD_CALL
  EVENT
  ADVERTISEMENT
  PARTNER
  MARKETPLACE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
  DISQUALIFIED
}

enum OpportunityStage {
  DISCOVERY
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
  ON_HOLD
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  WHATSAPP
  SMS
  SOCIAL
  OTHER
}

enum CrmTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CrmTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DEFERRED
}

model Lead {
  id                   String     @id @default(cuid())
  organizationId       String
  firstName            String
  lastName             String
  email                String?
  phone                String?
  company              String?
  jobTitle             String?
  source               LeadSource @default(OTHER)
  status               LeadStatus @default(NEW)
  score                Int        @default(0)
  tags                 String[]
  notes                String?
  convertedToContactId String?
  assignedToId         String?
  createdById          String
  /** Public Entity Registry id (e.g. ENTITY-00012) — links onboarding to CRM */
  registryEntityId     String?    @unique
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  assignedTo   User?        @relation("LeadAssignee", fields: [assignedToId], references: [id])
  createdBy    User         @relation("LeadCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
  @@index([email])
}

model CrmContact {
  id             String     @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  company        String?
  linkedUserId   String?
  ownerId        String?
  source         LeadSource @default(OTHER)
  tags           String[]
  notes          String?
  avatar         String?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  linkedUser   User?         @relation(fields: [linkedUserId], references: [id])
  owner        User?         @relation("ContactOwner", fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([ownerId])
  @@index([linkedUserId])
  @@index([email])
}

model Opportunity {
  id                String           @id @default(cuid())
  organizationId    String
  name              String
  amount            Decimal          @default(0)
  currency          String           @default("SAR")
  stage             OpportunityStage @default(DISCOVERY)
  probability       Int              @default(0)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  source            LeadSource       @default(OTHER)
  notes             String?
  tags              String[]
  leadId            String?
  contactId         String?
  companyName       String?
  ownerId           String?
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User?        @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdBy    User         @relation("OpportunityCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([ownerId])
  @@index([stage])
  @@index([leadId])
  @@index([contactId])
}

model CrmActivity {
  id              String          @id @default(cuid())
  organizationId  String
  type            CrmActivityType
  subject         String
  description     String?
  outcome         String?
  scheduledAt     DateTime?
  completedAt     DateTime?
  durationMinutes Int?
  assignedToId    String?
  createdById     String
  leadId          String?
  contactId       String?
  opportunityId   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  assignedTo   User?        @relation("ActivityAssignee", fields: [assignedToId], references: [id])
  createdBy    User         @relation("ActivityCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([assignedToId])
  @@index([type])
  @@index([leadId])
  @@index([contactId])
  @@index([opportunityId])
}

model CrmTask {
  id             String          @id @default(cuid())
  organizationId String
  subject        String
  description    String?
  status         CrmTaskStatus   @default(PENDING)
  priority       CrmTaskPriority @default(MEDIUM)
  dueDate        DateTime?
  completedAt    DateTime?
  assignedToId   String?
  createdById    String
  leadId         String?
  contactId      String?
  opportunityId  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model CrmMeeting {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime?
  location       String?
  meetingLink    String?
  status         String    @default("SCHEDULED")
  outcome        String?
  organizerId    String?
  leadId         String?
  contactId      String?
  opportunityId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  organizer    User?        @relation("MeetingOrganizer", fields: [organizerId], references: [id])

  @@index([organizationId])
  @@index([organizerId])
  @@index([startTime])
}

model CrmNote {
  id             String   @id @default(cuid())
  organizationId String
  content        String
  pinned         Boolean  @default(false)
  leadId         String?
  contactId      String?
  opportunityId  String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation("NoteCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([leadId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([pinned])
}

model Inspection {
  id              String           @id @default(cuid())
  inspectionNumber String          @unique
  type             String
  status           InspectionStatus @default(PENDING)
  referenceType    String
  referenceId      String
  inspectorId      String
  scheduledAt      DateTime?
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  inspector    User               @relation("QualityInspector", fields: [inspectorId], references: [id])
  items        InspectionItem[]
  attachments  InspectionAttachment[]
  ncrs         NCR[]
  certificates AcceptanceCertificate[]

  @@index([referenceType, referenceId])
  @@index([inspectorId])
  @@index([status])
  @@index([inspectionNumber])
}

model InspectionItem {
  id             String              @id @default(cuid())
  inspectionId   String
  deliveryItemId String?
  poItemId       String
  specification  String
  expectedValue  String?
  actualValue    String?
  result         InspectionItemResult?
  remarks        String?
  createdAt      DateTime            @default(now())

  inspection    Inspection @relation(fields: [inspectionId], references: [id])
  deliveryItem  DeliveryItem? @relation(fields: [deliveryItemId], references: [id])
  poItem        POItem       @relation(fields: [poItemId], references: [id])

  @@index([inspectionId])
  @@index([deliveryItemId])
  @@index([poItemId])
}

model InspectionAttachment {
  id           String   @id @default(cuid())
  inspectionId String
  type         String
  url          String
  fileName     String
  uploadedById String
  createdAt    DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id])
  uploadedBy User       @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([inspectionId])
  @@index([uploadedById])
}

model NCR {
  id              String    @id @default(cuid())
  ncrNumber       String    @unique
  inspectionId    String
  severity        NCRSeverity @default(MEDIUM)
  category        String
  description     String
  correctiveAction String?
  dueDate         DateTime?
  status          NCRStatus @default(OPEN)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id])
  createdBy  User       @relation("NCRCreator", fields: [createdById], references: [id])

  @@index([inspectionId])
  @@index([status])
  @@index([ncrNumber])
}

model AcceptanceCertificate {
  id              String   @id @default(cuid())
  certificateNumber String @unique
  inspectionId    String
  acceptedById    String
  acceptedAt      DateTime @default(now())
  remarks         String?
  createdAt       DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id])
  acceptedBy User       @relation("CertificateAcceptor", fields: [acceptedById], references: [id])

  @@index([inspectionId])
  @@index([acceptedById])
  @@index([certificateNumber])
}

model PaymentReservation {
  id               String                  @id @default(cuid())
  reservationNumber String                 @unique
  purchaseOrderId  String
  supplierId       String
  buyerId          String
  totalAmount      Float
  heldAmount       Float                   @default(0)
  releasedAmount   Float                   @default(0)
  currency         String                  @default("SAR")
  status           PaymentReservationStatus @default(RESERVED)
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  supplier      User            @relation("PaymentSupplier", fields: [supplierId], references: [id])
  buyer         User            @relation("PaymentBuyer", fields: [buyerId], references: [id])
  releases      PaymentRelease[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([buyerId])
  @@index([status])
}

model PaymentRelease {
  id              String              @id @default(cuid())
  reservationId   String
  amount          Float
  type            PaymentReleaseType
  notes           String?
  releasedById    String
  releasedAt      DateTime            @default(now())
  createdAt       DateTime            @default(now())

  reservation PaymentReservation @relation(fields: [reservationId], references: [id])
  releasedBy  User               @relation("PaymentReleaseActor", fields: [releasedById], references: [id])

  @@index([reservationId])
  @@index([releasedById])
}

enum WorkflowHistoryResult {
  SUCCESS
  BLOCKED_BY_GUARD
  INVALID_TRANSITION
  ERROR
}

model WorkflowHistory {
  id          String                @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  fromStatus  String
  toStatus    String?
  result      WorkflowHistoryResult @default(SUCCESS)
  guardName   String?
  reason      String?
  actorId     String?
  actorRole   String?
  metadata    Json?
  createdAt   DateTime              @default(now())

  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@index([result])
  @@index([createdAt])
}

// ============================
// ABC Entity Registry (Market Data Layer)
// Referenced: docs/pilot-validation/ABC-ENTITY-REGISTRY-SCHEMA.md (FINAL BASELINE)
// ISOLATION: These tables are intentionally NOT related to User/Organization.
// The only bridge to the Auth layer is Profile.userId (plain string, no FK),
// so Programmer 2 (Data) and Programmer 4 (AI) consume ONLY Entity + Profile.
// ============================

enum EntityType {
  CUST
  SUPP
  ECO
  INT
}

enum EntitySubtype {
  CONTRACTOR
  DEVELOPER
  CONSULTANT
  PROJECT_OWNER
  SUPPLIER
  MANUFACTURER
  DISTRIBUTOR
  MATERIAL_VENDOR
  STRATEGIC_PARTNER
  INDUSTRY_ASSOCIATION
  SERVICE_PROVIDER
  INVESTOR
  ADVISOR
  MEDIA
  POTENTIAL_TEAM_MEMBER
  SERVICE_STAFF
}

enum LanguagePreference {
  ARABIC
  ENGLISH
  URDU
}

enum EntityRelationshipStatus {
  NEW
  ENGAGED
  TRIAL
  ACTIVE
  CHURNED
}

enum EntitySource {
  LINKEDIN
  WHATSAPP
  EMAIL
  REFERRAL
  EVENT
  INTERNAL
}

enum PilotStatus {
  INVITED
  STARTED
  COMPLETED
  INTERVIEWED
  FT_TRIAL
}

enum CrmClassification {
  LEAD
  PROSPECT
  CUSTOMER
  SUPPLIER
  PARTNER
  INVESTOR
  OTHER_STAKEHOLDER
}

enum InteractionType {
  SURVEY
  INTERVIEW
  EMAIL
  CALL
  MEETING
  FEEDBACK
  PILOT_ACTIVITY
  REFERRAL
}

enum InteractionChannel {
  TYPEFORM
  WHATSAPP
  EMAIL
  PHONE
  IN_PERSON
  PLATFORM
}

enum WtpRange {
  UNDER_100
  RANGE_100_400
  RANGE_400_1000
  RANGE_1000_PLUS
}

enum CommissionAcceptance {
  NONE
  P_1_3
  P_3_5
  P_5_PLUS
}

enum AdoptionInterest {
  IMMEDIATELY
  MONTHS_6_12
  LATER
}

enum ConsentStatus {
  GRANTED
  DENIED
  NOT_REQUESTED
}

enum AllowedUsage {
  PRODUCT_RESEARCH
  CONTACT_FOR_PILOT
  EARLY_ADOPTER_LIST
}

enum RelationshipType {
  SERVES
  DEMANDS
  OWNS
  EXECUTES
  INITIATES
  BIDS
  RESULTS
  PARTNERS
  REFERS
  FUNDS
}

enum EntityLinkStatus {
  ACTIVE
  PENDING
  ENDED
}

model Entity {
  id                   String                  @id @default(cuid())
  entityId             String                  @unique
  entityType           EntityType
  entitySubtype        EntitySubtype
  companyName          String
  contactPerson        String?
  contactRole          String?
  contactEmail         String?
  contactPhone         String?
  languagePreference   LanguagePreference      @default(ARABIC)
  location             String?
  industrySegment      String?
  relationshipStatus   EntityRelationshipStatus @default(NEW)
  source               EntitySource
  sourceDetail         String?
  pilotStatus          PilotStatus?
  crmClassification    CrmClassification       @default(LEAD)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  profile      Profile?
  interactions Interaction[]
  validation   Validation?
  leadScore    LeadScoring?
  consent      Consent?
  relationshipsFrom Relationship[] @relation("RelationshipFrom")
  relationshipsTo   Relationship[] @relation("RelationshipTo")

  @@index([entityType])
  @@index([entitySubtype])
  @@index([crmClassification])
  @@index([relationshipStatus])
  @@index([source])
}

model Profile {
  id                 String   @id @default(cuid())
  profileId          String   @unique
  entityId           String   @unique
  userId             String?
  companySize        String?
  annualVolume       String?
  businessActivity   String?
  relevantCategories String[]
  subcategories      String[]
  hasCatalog         Boolean  @default(false)
  digitalMaturity    String?
  apiReadiness       String?
  capabilities       String[]
  surveyData         Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([userId])
}

model Interaction {
  id               String             @id @default(cuid())
  interactionId    String             @unique
  entityId         String
  type             InteractionType
  date             DateTime           @default(now())
  channel          InteractionChannel
  owner            String
  outcome          String?
  nextAction       String?
  relatedEntityId  String?
  createdAt        DateTime           @default(now())

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId])
  @@index([date])
  @@index([type])
}

model Validation {
  id                   String             @id @default(cuid())
  validationId         String             @unique
  entityId             String             @unique
  painPoints           String[]
  needs                String[]
  feedback             String?
  feedbackLanguage     String?
  willingnessToPay     WtpRange?
  commissionAcceptance CommissionAcceptance?
  adoptionInterest     AdoptionInterest?
  firstTransactionReady Boolean            @default(false)
  ftOrderValue         Float?
  assumptionResults    Json?
  validatedDate        DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])
}

model LeadScoring {
  id               String   @id @default(cuid())
  scoreId          String   @unique
  entityId         String   @unique
  strategicScore   Int      @default(0)
  engagementScore  Int      @default(0)
  commercialScore  Int      @default(0)
  conversionScore  Int      @default(0)
  totalLeadScore   Float    @default(0)
  tier             String   @default("Cold")
  scoredDate       DateTime @default(now())
  createdAt        DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id])
}

model Consent {
  id                  String            @id @default(cuid())
  consentId           String            @unique
  entityId            String            @unique
  consentStatus       ConsentStatus     @default(NOT_REQUESTED)
  consentDate         DateTime?
  consentVersion      String?
  language            LanguagePreference @default(ARABIC)
  allowedUsage        AllowedUsage[]
  deletionRequested   Boolean           @default(false)
  deletionRequestedAt DateTime?
  dataRetentionExpiry DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  entity Entity @relation(fields: [entityId], references: [id])
}

model Relationship {
  id               String           @id @default(cuid())
  relationshipId   String           @unique
  fromEntityId     String
  toEntityId       String
  relationshipType RelationshipType
  sinceDate        DateTime?
  status           EntityLinkStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime         @default(now())

  fromEntity Entity @relation("RelationshipFrom", fields: [fromEntityId], references: [id])
  toEntity   Entity @relation("RelationshipTo", fields: [toEntityId], references: [id])

  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([relationshipType])
  @@index([status])
}

// Atomic per-prefix counter used to generate sequential human-friendly IDs
// (ENTITY-00001, PROF-00001, ...) without in-memory state. Upsert-with-increment
// is safe under concurrent requests and multiple server instances.
model EntityRegistryCounter {
  id        String @id
  prefix    String @unique
  value     Int    @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Onboarding Survey Question Bank (Isolated) ───────────────────────────
// Stores the reusable onboarding/market-survey question bank. Isolated from the
// Research Survey engine (Survey/SurveySection/SurveyQuestion) — no FK, no
// coupling. Answers are persisted in full on Profile.surveyData (Json).

enum OnboardingAnswerType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DROPDOWN
  RATING
  LINEAR_SCALE
  YES_NO
  EMAIL
  PHONE
  DATE
}

model OnboardingQuestion {
  id           String               @id @default(cuid())
  category     String
  questionText String
  answerType   OnboardingAnswerType
  options      Json?
  order        Int                  @default(0)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([category])
  @@index([category, isActive])
}

// ─── Survey Config (Admin SurveyManager) ────────────────────────────────────
// "الأسئلة" في إدارة الاستبيان هي عناصر: الفئات (categories) والفئات الفرعية
// (subcategories). كل عنصر قابل للترتيب والتفعيل/التعطيل والإضافة والتعديل عبر
// واجهة SurveyManager. يتبع هذا النموذج عقد docs/api/survey-config-contract.md.
// id مفتاح مستقر (slug/cuid) يُحافظ عليه عبر الإصدارات لربط بيانات الردود.

model SurveyConfigItem {
  id        String   @id
  parentId  String?
  type      String
  labelEn   String
  labelAr   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([type])
  @@index([isActive])
}

// Admin-managed subcategories per platform account type (9 fixed types).
model AccountTypeSubcategory {
  id          String              @id @default(cuid())
  accountType PlatformAccountType
  labelEn     String
  labelAr     String
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([accountType])
  @@index([accountType, isActive])
}

// ─── AI Module (Sprint AI-1b — BOQ Intelligence) ───────────────────────────
// All models are additive and isolated to the AI domain. Tenant data is
// scoped by orgId (org isolation). AiExtractionVersion is a platform-level
// deployment registry (not tenant data).

enum AiJobType {
  EXTRACTION
  EMBEDDING
  ANALYSIS
  MATCHING
  RECOMMENDATION
}

enum AiJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

model AiJob {
  id        String      @id @default(cuid())
  orgId     String
  type      AiJobType
  status    AiJobStatus @default(PENDING)
  fileUrl   String?
  result    Json?
  error     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  usages AiUsage[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([type, createdAt])
}

model AiUsage {
  id         String   @id @default(cuid())
  orgId      String
  jobId      String?
  tokensUsed Int      @default(0)
  cost       Float    @default(0)
  model      String?
  createdAt  DateTime @default(now())

  job AiJob? @relation(fields: [jobId], references: [id])

  @@index([orgId])
  @@index([orgId, createdAt])
  @@index([jobId])
  @@index([model])
}

model AiQuota {
  id          String   @id @default(cuid())
  orgId       String
  month       String
  tokensUsed  Int      @default(0)
  tokensLimit Int?
  jobsUsed    Int      @default(0)
  jobsLimit   Int?

  @@unique([orgId, month])
  @@index([orgId, month])
}

model AiExtractionVersion {
  id         String    @id @default(cuid())
  version    String    @unique
  modelName  String
  schema     Json
  deployedAt DateTime  @default(now())
  active     Boolean   @default(false)
}

